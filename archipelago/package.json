{
  "name": "sumanth-archipelago",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "The Archipelago: four floating islands of work in a midnight sky, a tower of brands and a lighthouse at dawn.",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "assets": "node scripts/build-assets.mjs",
    "pages": "node scripts/build-pages.mjs",
    "build": "node scripts/build-pages.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@types/opentype.js": "^1.3.10",
    "@types/three": "^0.186.0",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource/antonio": "^5.2.8",
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "opentype.js": "^1.3.4",
    "postprocessing": "^6.39.5",
    "three": "^0.186.1"
  }
}
